{
  "info": {
    "_postman_id": "a1b2c3d4-stockflow-2026-api",
    "name": "StockFlow - Supermarket API REST",
    "description": "Colección de pruebas para el backend en Node.js + Express + TypeScript del proyecto StockFlow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Productos (Implementados)",
      "item": [
        {
          "name": "Listar todos los productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Obtiene todo el catálogo inicial en memoria."
          }
        },
        {
          "name": "Filtrar productos por categoría y búsqueda",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?category=Abarrotes&search=arroz",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "category",
                  "value": "Abarrotes",
                  "description": "Categorías válidas: Abarrotes, Lácteos, Bebidas, Combos"
                },
                {
                  "key": "search",
                  "value": "arroz",
                  "description": "Texto parcial del nombre del producto"
                }
              ]
            },
            "description": "Filtra el catálogo usando Query Params."
          }
        },
        {
          "name": "Obtener detalle de producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            },
            "description": "Busca un producto específico por su ID numérico (ej. ID 1: Galletas Spider-Man)."
          }
        },
        {
          "name": "Crear nuevo producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pan Tajado Bimbo 600g\",\n  \"category\": \"Abarrotes\",\n  \"price\": 6800,\n  \"stock\": 45,\n  \"img\": \"img/pan-bimbo.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Crea un nuevo producto en el arreglo en memoria y devuelve estado 201 Created."
          }
        }
      ]
    },
    {
      "name": "2. Autenticación (Implementados)",
      "item": [
        {
          "name": "Registrar nuevo usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"Diego Prueba\",\n  \"email\": \"diego@stockflow.com\",\n  \"password\": \"1234\",\n  \"confirmPassword\": \"1234\",\n  \"phone\": \"3001234567\",\n  \"address\": \"Calle 123 # 45-67, Bogotá\"\n}"
          },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Simula el envío del formulario register.html."
          }
        },
        {
          "name": "Iniciar sesión (Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"diego@stockflow.com\",\n  \"password\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Simula el envío del formulario login.html. Requiere haber registrado el usuario previamente."
          }
        }
      ]
    },
    {
      "name": "3. Pedidos (Implementados)",
      "item": [
        {
          "name": "Confirmar Pedido Anticipado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    {\n      \"productId\": 2,\n      \"quantity\": 3\n    },\n    {\n      \"productId\": 4,\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Procesa el carrito de compras, calcula el total y descuenta el stock en memoria."
          }
        }
      ]
    },
    {
      "name": "4. Endpoints Documentados (Fase PostgreSQL)",
      "item": [
        {
          "name": "[Doc] Actualizar stock de producto",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1", "stock"]
            },
            "description": "Endpoint documentado en inventario para actualización administrativa de stock."
          }
        },
        {
          "name": "[Doc] Listar historial de pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?userId=1",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            },
            "description": "Endpoint documentado para consultar pedidos históricos."
          }
        },
        {
          "name": "[Doc] Cancelar pedido anticipado",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/101",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "101"]
            },
            "description": "Endpoint documentado para anular orden y restaurar stock."
          }
        }
      ]
    }
  ]
}
